# =============================================================================
# .env.local — Local Development Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit the filled .env to git.
# =============================================================================

AICOS_ENV=local

# Microsoft Entra ID (formerly Azure AD)
TENANT_ID=your-tenant-id
CLIENT_ID=your-app-registration-client-id
CLIENT_SECRET=your-client-secret

# The Outlook mailbox to monitor
USER_EMAIL=you@yourdomain.com

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Azure Storage (use Azurite for local dev)
STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# OneDrive folder ID for tracker workbooks
# Get from: https://graph.microsoft.com/v1.0/me/drive/root
ONEDRIVE_FOLDER_ID=

# Workbook IDs (set after creating workbooks in OneDrive)
FINANCE_WORKBOOK_ID=
CAREER_WORKBOOK_ID=
ASSET_WORKBOOK_ID=

# AI Model overrides (optional — use DEFAULTS from Config.ts if not set)
AI_MODEL_CLASSIFY=claude-haiku-20240307
AI_MODEL_BRIEF=claude-sonnet-4-5
AI_MODEL_DRAFT=claude-haiku-20240307

# Webhook
WEBHOOK_SECRET=local-dev-secret

# Azure resources (not needed for local dev)
# KEY_VAULT_URL=
# APP_CONFIG_ENDPOINT=
